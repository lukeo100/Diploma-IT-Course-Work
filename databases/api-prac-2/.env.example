# Supabase SESSION POOLER connection for the "Learning" project (ap-southeast-2).
# The pooler works over IPv4. The direct connection is IPv6 only and fails on many networks.
# Replace YOUR_DB_PASSWORD with your database password
# (Supabase dashboard > Project Settings > Database).
# If the password has special characters, URL-encode them (@ becomes %40, # becomes %23).
#
# "postgresql+psycopg" is the scheme SQLAlchemy (v2_orm) needs.
# The psycopg version (v1_psycopg) strips the "+psycopg" part itself.
# Port 5432 = session mode (keep it, do not use 6543).
DATABASE_URL=postgresql+psycopg://postgres.cbdnpfmerhbbxgqjqvig:YOUR_DB_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require

# Direct connection (IPv6 only, use it only if your network supports IPv6):
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.cbdnpfmerhbbxgqjqvig.supabase.co:5432/postgres?sslmode=require
